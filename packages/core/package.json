    "@parallax/connector-sdk": "workspace:*",
    "@parallax/connector-gcp": "workspace:*",
    "@parallax/connector-sentry": "workspace:*",
    "@parallax/connector-github": "workspace:*",
    "@parallax/plugin-investigation": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
